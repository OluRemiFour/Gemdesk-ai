{
  "name": "gemdesk",
  "private": true,
  "version": "0.0.0",
  "description": "A lightweight, developer-first remote desktop tool with AI capabilities",
  "author": {
    "name": "GemDesk Team",
    "email": "support@gemdesk.app"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build-no-errors": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "electron .",
    "clean": "node scripts/clean.js",
    "build:frontend": "tsc && vite build",
    "build:electron": "npm run clean && cross-env CSC_SKIP=true electron-builder --win",
    "build": "npm run build:frontend && npm run build:electron"
  },
  "build": {
    "appId": "com.gemdesk.app",
    "productName": "GemDesk",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OluRemiFour",
        "repo": "Gemdesk-ai"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      ".env"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/nut-js/**/*",
      "**/node_modules/sharp/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GemDesk"
    }
  },
  "dependencies": {
    "@capacitor/cli": "^8.0.2",
    "@google/genai": "^1.39.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.7.3",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.394.0",
    "mongodb": "^7.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.1",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "3.4.1",
    "typescript": "^5.8.2",
    "vite": "^7.1.12",
    "wait-on": "^7.2.0"
  }
}
